<?xml version="1.0" encoding="UTF-8"?>

<lyricproviders>

  <provider name="elyrics.net"
            title="{title} Lyrics - {artist}"
            charset="iso-8859-1"
            url="https://www.elyrics.net/read/{a}/{artist}-lyrics/{title}-lyrics.html">
    <urlFormat replace=" _@;&amp;\/&quot;" with="-"/>
    <urlFormat replace="'" with="_"/>
    <extract>
      <item begin="&lt;div id='inlyr' class='translate'&gt;" end="&lt;/div&gt;"/>
    </extract>
    <exclude>
      <item begin="Songwriters:" end="&lt;br&gt;"/>
    </exclude>
    <invalidIndicator value="Page not Found"/>
  </provider>

  <provider name="genius.com"
          charset="utf-8"
          url="https://genius.com/{artist}-{title}-lyrics">
    <urlFormat replace=",._@!#%^*+;\/&quot;'()[]" with=""/>
    <urlFormat replace=" :" with="-"/>
    <urlFormat replace="$" with=""/>
    <urlFormat replace="ÄÂÀÁÃäâàáã" with="a"/>
    <urlFormat replace="ËÊÈÉëêèé" with="e"/>
    <urlFormat replace="ÏÌïì" with="i"/>
    <urlFormat replace="ÖÔÒÓÕöôòóõ" with="o"/>
    <urlFormat replace="ÜŪÙÚüūùú" with="u"/>
    <urlFormat replace="ŸÝÿý" with="y"/>
    <urlFormat replace="Ññ" with="n"/>
    <urlFormat replace="Çç" with="c"/>
    <urlFormat replace="ß" with="ss"/>
    <urlFormat replace="&amp;" with="and"/>
  </provider>

  <provider name="lololyrics.com"
          title="{Artist} - {Title} lyrics"
          charset="utf-8"
          url="https://www.lololyrics.com/letter/{A}">
    <extract>
      <item url="https://www.lololyrics.com/lyrics/{id}.html"/>
      <item begin="&gt;{Artist}&lt;/a&gt;&lt;/td&gt;&#10;&lt;td class=&quot;track&quot;&gt;&lt;a href=&quot;/lyrics/"
        end=".html&quot;&gt;{Title}&lt;/a&gt;"/>
    </extract>
    <extract>
      <item begin="&lt;div class=&quot;lyrics_txt&quot; id=&quot;lyrics_txt&quot;"
            end="&lt;/div&gt;"/>
    </extract>
  </provider>

  <provider name="lyricsmania.com"
            title="{artist} - {title} Lyrics"
            charset="iso-8859-1"
            url="https://www.lyricsmania.com/{title}_lyrics_{artist}.html">
    <urlFormat replace=" _@;&amp;\/&quot;'." with="_"/>
    <extract>
      <item begin="&lt;div class=&quot;lyrics-body&quot;&gt;" end="&lt;/div&gt;"/>
    </extract>
    <invalidIndicator value="The lyrics you requested is not in our archive yet,"/>
  </provider>

  <provider name="lyricsmode.com"
          title="{artist} - {title} lyrics"
          charset="iso-8859-1"
          url="https://www.lyricsmode.com/lyrics/{a}/{artist}/{title}.html">
    <urlFormat replace=" ._@,;&amp;\/&quot;" with="_"/>
    <extract>
      <item begin="&lt;div id=&quot;lyrics_text&quot;" end="&lt;/div&gt;"/>
    </extract>
    <invalidIndicator value="Sorry, we have no"/>
  </provider>

  <provider name="songlyrics.com"
            title="{title} LYRICS - {artist}"
            charset="utf-8"
            url="https://www.songlyrics.com/{artist}/{title}-lyrics/">
    <urlFormat replace=" ._@,;&amp;\/&quot;" with="-"/>
    <urlFormat replace="'" with="_"/>
    <extract>
      <item begin="&lt;div id=&quot;songLyricsDiv&quot; class=&quot;lyrics-body&quot;&gt;" end="&lt;div id=&quot;sl-player-below&quot;&gt;"/>
    </extract>
    <exclude>
      <item begin="&#10;[" end="] "/>
    </exclude>
    <invalidIndicator value="Sorry, we have no"/>
    <invalidIndicator value="This is an upcoming album and we do not have the"/>
  </provider>

  <provider name="tekstowo.pl (Original lyric language)"
          title="{artist} - {title} - tekst"
          charset="utf-8"
          url="https://www.tekstowo.pl/{artist}/{title}">
    <urlFormat replace=" _@,;&amp;\/'&quot;." with="-"/>
    <extract>
      <item begin="&lt;div class=&quot;inner-text&quot;&gt;"
            end="&lt;/div&gt;"/>
    </extract>
  </provider>

  <provider name="tekstowo.pl (Translated to Polish)"
            title="{artist} - {title} - tekst"
            charset="utf-8"
            url="https://www.tekstowo.pl/{artist}/{title}">
    <urlFormat replace=" _@,;&amp;\/'&quot;." with="-"/>
    <extract>
      <item begin="&lt;div id=&quot;translation&quot; class=&quot;" end="&lt;a href="/>
    </extract>
    <exclude>
      <item begin="&quot;id-" end="&quot;&gt;"/>
    </exclude>
  </provider>

  <provider name="vagalume.com.br"
          title="{title} de {artist} no VAGALUME"
          charset="iso-8859-1"
          url="https://www.vagalume.com.br/{artist}/{title}.html">
    <urlFormat replace=" _@,;&amp;\/'&quot;." with="-"/>
    <extract>
      <item begin="&lt;div id=lyrics&gt;"
            end="&lt;/div&gt;"/>
    </extract>
  </provider>

  <provider name="vagalume.com.br (Portuguese translations)"
          title="{title} de {artist} no VAGALUME"
          charset="iso-8859-1"
          url="https://www.vagalume.com.br/{artist}/{title}-traducao.html">
    <urlFormat replace=" _@,;&amp;\/'&quot;." with="-"/>
    <extract>
      <item begin="&lt;div class=&quot;trad pair line2&quot;&gt;"
            end="&lt;div class=&quot;orig pair songTitle line0&quot;&gt;"/>
    </extract>
  </provider>

</lyricproviders>
